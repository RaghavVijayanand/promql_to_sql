# ============================================================
# GAP → ClickStack Migration — Client Configuration
# ============================================================
# Copy this file to .env and fill in values for your environment.
# Every setting has a sensible default; override only what differs.
# ============================================================

# ── Source: Prometheus ────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090

# ── Source: Grafana ───────────────────────────────────────────
GRAFANA_URL=http://localhost:3000
GRAFANA_API_TOKEN=
# Service-account or API-key token. Leave blank for anonymous access.

# ── Source: Alertmanager ──────────────────────────────────────
ALERTMANAGER_URL=http://localhost:9093

# ── Target: ClickHouse (inside ClickStack) ────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=otel
# Native port (9000) is also available; HTTP (8123) is used by default.

# ── Target: HyperDX (inside ClickStack) ──────────────────────
HYPERDX_URL=http://localhost:8080
HYPERDX_API_KEY=
# API key for creating dashboards and alerts programmatically.

# ── Transpiler Binary ────────────────────────────────────────
# Path to the compiled promql-transpiler binary.
# Relative paths are resolved from the migration/ directory.
# Windows: ../bin/promql-transpiler.exe   Linux/macOS: ../bin/promql-transpiler
TRANSPILER_BINARY=

# ── OTel Table Names (auto-detected when empty) ──────────────
# If your ClickStack uses non-standard table names, set them here.
# Leave empty to auto-detect via system.tables introspection.
OTEL_METRICS_TABLE_GAUGE=
OTEL_METRICS_TABLE_SUM=
OTEL_METRICS_TABLE_HISTOGRAM=
OTEL_METRICS_TABLE_SUMMARY=

# ── Metric Name Convention ────────────────────────────────────
# auto   – probe ClickHouse and pick whichever convention the data uses
# prometheus – underscore style  (http_requests_total)
# otel     – dot style           (http.requests.total)
METRIC_NAME_STYLE=auto

# ── Migration Behaviour ──────────────────────────────────────
MIGRATION_DRY_RUN=false
# When true, nothing is created — only the migration plan is printed.

MIGRATION_PRUNE_ORPHANS=false
# When true, artefacts in ClickStack that no longer exist in the source
# are deleted. Use with caution.

MIGRATION_LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR

# ── ClickHouse Optimisation ──────────────────────────────────
PARTITION_RETENTION_DAYS=90
# TTL in days for materialized view target tables.

VIEW_PARTITION_BY=
# Custom PARTITION BY expression for MV target tables.
# Leave empty to auto-derive from timestamp column: toYYYYMM(TimeUnix).

DEFAULT_CH_ENGINE=MergeTree
# Default MergeTree engine variant for source tables.
# MergeTree | ReplacingMergeTree | SummingMergeTree | AggregatingMergeTree

# ── Time Range Defaults (for transpiler) ──────────────────────
# Used to generate representative SQL; actual ranges are parameterised.
DEFAULT_START_TIME=2024-01-01T00:00:00Z
DEFAULT_END_TIME=2024-01-01T23:59:59Z
DEFAULT_STEP=60s

# ── Network / Retry Settings ─────────────────────────────────
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRY_COUNT=3
HTTP_RETRY_DELAY_SECONDS=2
